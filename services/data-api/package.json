{
  "name": "@qhint/data-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file=../../.env.development --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node ../../scripts/build-service.mjs data-api",
    "try-ingest": "tsx --env-file-if-exists=../../.env.development --env-file-if-exists=../../.env scripts/try-ingest.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@google-cloud/storage": "^8.4.0",
    "@qhint/prompts": "workspace:*",
    "@qhint/schema": "workspace:*",
    "@qhint/server-kit": "workspace:*",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "google-auth-library": "^11.3.3",
    "kysely": "^0.29.8",
    "zod": "^4.6.7"
  }
}
