# Local development settings for the services. Committed on purpose: every value here only works
# against the local Docker emulators. Never put real secrets in this file (use .env, gitignored).
FIREBASE_PROJECT_ID=demo-qhint
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_API_KEY=demo-api-key
STORAGE_EMULATOR_HOST=http://127.0.0.1:4443
CONTROL_API_URL=http://127.0.0.1:8081
DATA_API_URL=http://127.0.0.1:8082
# Local-only shared token for data-api -> control-api calls (Cloud Run uses Google ID tokens).
INTERNAL_TOKEN=local-dev-internal-token-not-a-secret-0001
# Local-only analytics hashing key (production uses a generated secret).
ANALYTICS_HASH_KEY=local-dev-analytics-hash-key-not-a-secret-0001
