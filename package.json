{
  "name": "qhint",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev": "pnpm infra:up && pnpm db:setup && pnpm -r --parallel dev",
    "dev:desktop": "pnpm --filter @qhint/desktop dev",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "build:services": "node scripts/build-service.mjs control-api && node scripts/build-service.mjs data-api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@qhint/server-kit": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^14.5.0",
    "globals": "^17.14.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
