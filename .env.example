# Copy to .env only if you need to override the local defaults. Never commit .env.
# Every value below is a local-dev default; real secrets live in GCP Secret Manager.

# Postgres (docker compose)
DATABASE_URL=postgres://qhint:qhint_dev@127.0.0.1:5432/qhint

# Firebase Auth emulator (docker compose). "demo-" project ids never reach real Google APIs.
FIREBASE_PROJECT_ID=demo-qhint
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Cloud Storage stub (docker compose)
STORAGE_EMULATOR_HOST=http://127.0.0.1:4443
CONTENT_BUCKET=qhint-dev-content

# Model provider key: backend (data-api) only. Put the real value in .env (gitignored), never in
# the desktop app. Without it, local model calls answer "not sure".
ANTHROPIC_API_KEY=
